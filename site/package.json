{
  "name": "claude-unlimited-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env VITEPRESS_DEV=1 node scripts/copy_public.mjs --watch",
    "dev:site": "vitepress dev --host 0.0.0.0 --port 5199 --strictPort",
    "build": "npm run check:kefu && npm run check:plans && vitepress build && npm run gen:sitemap && node scripts/copy_dir_overviews.mjs && npm run gen:jsonld && node scripts/copy_public.mjs && node scripts/check_dist.mjs",
    "preview": "vitepress preview --host 0.0.0.0 --port 4199 --strictPort",
    "gen:sitemap": "tsx scripts/gen_sitemap.ts",
    "gen:jsonld": "tsx scripts/gen_jsonld.ts",
    "check:links": "tsx scripts/check_links.ts",
    "check:dist": "node scripts/check_dist.mjs",
    "check:kefu": "tsx scripts/check_kefu.ts",
    "check:plans": "tsx scripts/check_plans.ts",
    "sync:plans": "tsx scripts/sync_shop_plans.ts",
    "verify": "python scripts/verify_build.py",
    "gen:og": "python scripts/gen_og.py",
    "gen:og:knowledge": "python scripts/gen_knowledge_og.py",
    "gen:routes": "node scripts/gen_knowledge_routes.mjs",
    "gen:sources": "python scripts/gen_sources.py",
    "check:sources": "python scripts/gen_sources.py --check",
    "check:seo": "python scripts/check_seo_meta.py",
    "check:toc": "node scripts/check_knowledge_toc.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.1.10",
    "cross-env": "^7.0.3"
  }
}
