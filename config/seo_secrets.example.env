# 官网 SEO 提交用密钥模板（IndexNow / Bing / GSC）
# 复制到 config/local/seo_secrets.env 后填真值；config/local/ 已 gitignore
# 消费脚本：site/scripts/seo_notify.ps1

WEBSITE_HOST=claude-unlimited.aiautotools.com
WEBSITE_ORIGIN=https://claude-unlimited.aiautotools.com

# —— IndexNow —— 密钥文件在 site/public/<key>.txt，内容就是 key 本身（协议要求）
INDEXNOW_KEY=

# —— Bing Webmaster：账号级 API Key；站点条目与所有权验证需在 bing.com/webmasters 单独做 ——
BING_API_KEY=
BING_SITE_URL=https://claude-unlimited.aiautotools.com/

# —— Google Search Console：网域属性 sc-domain:aiautotools.com，一条 TXT 覆盖全部子域 ——
# 服务账号 JSON 放 config/local/website_gsc_service_account.json
GOOGLE_APPLICATION_CREDENTIALS=../config/local/website_gsc_service_account.json
GSC_SITE_URL=sc-domain:aiautotools.com

# —— 百度：需先在 ziyuan.baidu.com 为该子域单独加站并验证，再从「链接提交」页复制 token ——
# site 只填主机名，不要 https://
# 注意：token 实测是「账号级」而非「站点级」，同一账号下多个已加站的子域可共用一个 token，
#       配额也是账号总配额（所以别拿 A 站的 token 以为能绕开 B 站的配额）。本站当前用的是
#       aiautotools 账号下 Product 项目的同一个 token；日后想独立配额，换成本站后台的 token 即可。
BAIDU_SITE=claude-unlimited.aiautotools.com
# BAIDU_TOKEN=

# 走 Google API 才需要代理；没开 Clash Verge 时保持注释（脚本读到空值就直连）
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
