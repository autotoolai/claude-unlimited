# 官网流量看板用密钥模板（Umami Cloud / Cloudflare）
# 复制到 config/local/analytics_secrets.env 后填真值；config/local/ 已 gitignore
# 消费脚本：site/scripts/analytics/fetch_data.py（环境变量优先于本文件）
# 站点埋点的 website id 另见 site/.vitepress/analytics_snippets.ts（那两项会进 HTML，是公开标识）

# —— Umami Cloud（https://cloud.umami.is 免费 Hobby：10 万事件/月、1 站、保留 6 个月）——
# API key：Umami 后台 右上头像 → Settings → API keys → Create key（只显示一次）
# Cloud 免费档只能用 API key 认证，没有 username/password 登录接口
UMAMI_API_KEY=
# website id：Umami 后台 添加站点 时拿到的 32 位 hex（同样在 Settings 可见）
# 埋点脚本要用它，填 site/.vitepress/analytics_snippets.ts 的 umamiWebsiteId 内联兜底值
UMAMI_WEBSITE_ID=
# 自建 Umami 才需要改；官方云保持默认
UMAMI_BASE_URL=https://cloud.umami.is

# —— Cloudflare：拉站点级请求量（含爬虫与静态资源）——
# token 要带 Zone → Analytics:Read 权限；本机部署脚本用的 CLOUDFLARE_API_TOKEN 一般已带
CLOUDFLARE_API_TOKEN=
# 不用填 zone id：脚本按 claude-unlimited.aiautotools.com 的父 zone（aiautotools.com）自动查
